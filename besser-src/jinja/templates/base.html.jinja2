<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ dsml.text.appName }}{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        :root {
            --primary-color: {{ dsml.theme.primaryColor | default('#3b82f6') }};
            --font-family: {{ dsml.theme.fontFamily | default('sans-serif') }};
            --bg-image: url('{{ dsml.theme.backgroundImage }}');
        }

        body {
            font-family: var(--font-family);
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 0;
        }

        #common-header {
            width: 100%;
            height: 64px;
            border: none;
            display: block;
            overflow: hidden;
        }
    </style>
    {% block head %}{% endblock %}
</head>
<body class="bg-gray-100 min-h-screen flex flex-col">

    {# Common Screen #}
    <header class="w-full z-50">
        <object id="common-header" type="text/html" data="common.html"></object>
    </header>
    <main class="flex-grow container mx-auto px-4 py-6">
        {% block content %}{% endblock %}
    </main>

    {% block scripts %}{% endblock %}
</body>
</html>