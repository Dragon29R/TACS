{% extends "base.html.jinja2" %}

{% block content %}
<div id="ListingDetailsScreen">
    
    {# --- 1. Load Configuration Variables --- #}
    {% set item_config = dsml.blocks.blocks[0].inputs.ITEMCONFIG.block.fields %}
    {# Cite: DSML_model.json (ITEMCONFIG fields) #}
    
    {% set exchange_type = dsml.blocks.blocks[0].inputs.ITEMCONFIG.block.inputs.ITEMEXCHANGE.block.fields.name %}
    {# Cite: DSML_model.json (ITEMEXCHANGE name) #}

    <div id="IMAGEGALLERY">
        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRn4hghPlqKrr0HDYjrRrXEPxzpnIDS7sJqmw&s" alt="Item Image" style="width:100%;" />
    </div>

    <h1 id="TITLELABEL">Vintage Camera</h1>

    {# --- 2. Conditional Price Display Logic --- #}
    
    {# Show 'Buy Now' Price only if enabled in ITEMCONFIG #}
    {% if item_config.enableBuyNowPrice == 'True' %}
        <h3 id="PRICELABEL" style="color: green;">Buy Now Price: $150.00</h3>
    {% endif %}

    {# Show 'Starting Bid' only if it is an Auction #}
    {% if exchange_type == 'Auction' %}
        <h3 id="STARTINGPRICELABEL" style="color: var(--primary-color);">Starting Bid: $50.00</h3>
    {% endif %}


    {# --- 3. Interaction Controls --- #}

    {# Auction Controls #}
    {% if exchange_type == 'Auction' %}
        <div class="bidding-section">
            <label>Current Bid: $55.00</label>
            <br/>
            <input type="number" id="BIDINPUT" placeholder="Enter amount" />
            <button id="BIDBUTTON">Place Bid</button>
        </div>
        
        {% if item_config.enableBiddingTimer == 'True' %}
            <p id="timer" style="color: red;">Time Remaining: 02:00:00</p>
        {% endif %}
    {% endif %}

    {# Buy Now Controls #}
    {% if item_config.enableBuyNowPrice == 'True' %}
        <div class="buy-now-section" style="margin-top: 10px;">
            <button id="BUYNOWBUTTON" style="background-color: green; color: white; padding: 10px;">Buy Now</button>
        </div>
    {% endif %}

</div>
{% endblock %}