{% extends "base.html.jinja2" %}

{% block content %}
{# --- 1. Setup Context Variables --- #}
{% set item = data.item1 %}

<div id="ListingDetailsScreen" class="max-w-4xl mx-auto space-y-8">

    {# --- Image Section --- #}
    {% if gui_model.get_class_by_name('MainImageComponent') %}
    <div id="MainImageComponent" class="theme-bg-card rounded-2xl overflow-hidden h-96 flex items-center justify-center shadow-sm border theme-border">
        <img src="{{ item.details.images[0] if item.details.images else 'https://via.placeholder.com/800' }}" 
             alt="Item" class="h-full w-full object-cover" />
    </div>
    {% endif %}

    {% if gui_model.get_class_by_name('ImageGalleryComponent') %}
    <div id="ImageGalleryComponent" class="flex gap-3 overflow-x-auto py-2">
        {% if item.details.images %}
            {% for img_url in item.details.images[:dsml.constraints.maxPhotos] %}
            <div class="h-24 w-24 flex-shrink-0 rounded-xl overflow-hidden border theme-border cursor-pointer hover:opacity-80 transition theme-bg-card">
                <img src="{{ img_url }}" class="h-full w-full object-cover" alt="Gallery Image">
            </div>
            {% endfor %}
        {% else %}
            <div class="h-24 w-24 bg-gray-300 rounded-xl"></div>
        {% endif %}
    </div>
    {% endif %}

    {# --- Title & Description --- #}
    <div class="space-y-4 border-b theme-border pb-8">
        {% if gui_model.get_class_by_name('ProductTitleLabel') %}
        <h1 id="ProductTitleLabel" class="text-3xl md:text-4xl font-extrabold theme-text-main">
            {{ item.details.title if item.details.title else 'Product Title' }}
        </h1>
        {% endif %}

        {% if gui_model.get_class_by_name('LocationField') %} 
        <div class="flex items-center gap-2 theme-text-muted mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
            </svg>
            <span class="text-sm font-medium">
                {{ item.details.location if item.details.location else 'Location not listed' }}
            </span>
        </div>
        {% endif %}

        {% if gui_model.get_class_by_name('ProductDescriptionLabel') %}
        <p id="ProductDescriptionLabel" class="theme-text-muted text-lg leading-relaxed">
            {{ item.details.description if item.details.description else 'No description provided.' }}
        </p>
        {% endif %}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        
        {# --- Auction Block --- #}
        {% if gui_model.get_class_by_name('AuctionDetailsComponent') %}
        <div class="space-y-6">
            <div id="AuctionDetailsComponent" class="theme-bg-card border theme-border p-6 rounded-2xl shadow-sm relative overflow-hidden">
                <div class="absolute top-0 left-0 w-full h-1" style="background-color: var(--primary-color);"></div>

                <h3 class="font-bold text-lg mb-4 theme-text-main">Auction Details</h3>
                
                {% if gui_model.get_class_by_name('BidField') %}
                <div class="mb-5">
                    <label class="text-xs font-bold theme-text-muted uppercase tracking-wider">Your Bid</label>
                    <input type="number" id="BidField" placeholder="Enter amount..." 
                           class="w-full mt-2 theme-bg-card border theme-border theme-text-main p-4 rounded-xl focus:ring-2 focus:outline-none transition-shadow"
                           style="--tw-ring-color: var(--primary-color);" />
                </div>
                {% endif %}

                {% if gui_model.get_class_by_name('BidNowButton') %}
                <button id="BidNowButton" class="w-full text-white font-bold py-4 rounded-xl shadow-lg transition transform active:scale-95 hover:brightness-110" 
                        style="background-color: var(--primary-color);">
                    Place Bid
                </button>
                {% endif %}
            </div>

            {# --- Bid History List --- #}
            {% if item.bids %}
            <div class="theme-bg-card rounded-2xl border theme-border overflow-hidden shadow-sm">
                <div class="px-5 py-3 border-b theme-border" style="background-color: var(--bg-color);">
                    <h4 class="text-sm font-bold theme-text-muted">Recent Activity</h4>
                </div>
                
                <div class="divide-y theme-border">
                    {% for bid in item.bids | sort(attribute='amount', reverse=True) %}
                    <div class="flex justify-between items-center p-4 transition-colors duration-200"
                         onmouseover="this.style.backgroundColor='var(--hover-bg)'"
                         onmouseout="this.style.backgroundColor='transparent'">
                         
                        <div class="flex flex-col">
                            <span class="text-sm font-semibold theme-text-main">{{ bid.username }}</span>
                            <span class="text-xs theme-text-muted">{{ bid.timestamp }}</span>
                        </div>
                        <span class="font-mono font-bold text-green-500 text-lg">${{ bid.amount }}</span>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </div>
        {% endif %}

        {# --- Exchange Block --- #}
        {% if gui_model.get_class_by_name('ExchangeDetailsComponent') %}
        <div id="ExchangeDetailsComponent" class="theme-bg-card border theme-border p-6 rounded-2xl shadow-sm h-fit relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-purple-500"></div>
            
            <h3 class="font-bold text-lg theme-text-main mb-4">Propose Exchange</h3>
            <p class="text-sm theme-text-muted mb-4">Offer an item or service in exchange.</p>

            {% if gui_model.get_class_by_name('ProposedExchangeField') %}
            <div class="mb-5">
                <label class="text-xs font-bold theme-text-muted uppercase tracking-wider">Your Offer</label>
                <textarea id="ProposedExchangeField" rows="2" placeholder="Describe what you want to trade..." 
                       class="w-full mt-2 theme-bg-card border theme-border theme-text-main p-3 rounded-xl focus:ring-2 focus:outline-none transition-shadow"
                       style="--tw-ring-color: #a855f7;"></textarea>
            </div>
            {% endif %}

            {% if gui_model.get_class_by_name('ExchangeNowButton') %}
            <button id="ExchangeNowButton" class="w-full text-white font-bold py-4 rounded-xl shadow-lg transition transform active:scale-95 hover:brightness-110"
                    style="background-color: #a855f7;">
                Propose Trade
            </button>
            {% endif %}
        </div>
        {% endif %}

        {# --- Sale Block --- #}
        {% if gui_model.get_class_by_name('SaleDetailsComponent') %}
        <div id="SaleDetailsComponent" class="theme-bg-card border theme-border p-6 rounded-2xl shadow-sm h-fit relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1 bg-green-500"></div>

            <h3 class="font-bold text-lg theme-text-main mb-6">Direct Purchase</h3>

            {% if gui_model.get_class_by_name('PriceLabel') %}
            <div class="mb-6">
                <span class="text-sm theme-text-muted">Current Price</span>
                <div id="PriceLabel" class="text-5xl text-green-500 font-black tracking-tight mt-1">
                    ${{ item.details.price if item.details.price else '0.00' }}
                </div>
            </div>
            {% endif %}

            {% if gui_model.get_class_by_name('BuyNowButton') %}
            <button id="BuyNowButton" class="w-full bg-green-600 text-white font-bold py-4 rounded-xl hover:bg-green-700 transition shadow-lg shadow-green-500/20 transform active:scale-95">
                Buy It Now
            </button>
            {% endif %}
        </div>
        {% endif %}
    </div>

</div>
{% endblock %}