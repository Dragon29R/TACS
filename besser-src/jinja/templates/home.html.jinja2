{% extends "base.html.jinja2" %}

{% block content %}
<div id="HomeScreen" class="flex flex-col h-full">
    
    {# --- Hero / Header Section --- #}
    <header class="theme-bg-card shadow-sm border-b theme-border mb-8 rounded-xl overflow-hidden">
        <div class="max-w-4xl mx-auto px-4 py-10 text-center">
            <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight theme-text-main">
                Welcome to 
                <span id="HEADER_TITLE" style="color: var(--primary-color);">
                    {{ dsml.text.appName if dsml.text.appName else 'Marketplace' }}
                </span>
            </h2>
            <p class="mt-3 text-lg theme-text-muted">What would you like to do today?</p>
        </div>
    </header>

    {# --- Main Navigation Grid --- #}
    <nav id="MENU" class="flex-grow w-full max-w-6xl mx-auto">
        <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            
            {# Auctions Card #}
            <li class="group h-full">
                <a href="listings.html" class="block h-full p-8 rounded-2xl border theme-bg-card theme-border theme-card-hover transition-all duration-300 flex flex-col items-center text-center shadow-sm hover:shadow-md transform hover:-translate-y-1">
                    <div class="h-14 w-14 rounded-full flex items-center justify-center mb-4 transition-colors bg-blue-50 text-blue-600 group-hover:bg-blue-600 group-hover:text-white">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </div>
                    <span class="text-xl font-bold theme-text-main group-hover:text-blue-600 transition-colors">Browse Auctions</span>
                    <p class="mt-2 text-sm theme-text-muted">Find great deals and bid on unique items.</p>
                </a>
            </li>

            {# Sell Item Card #}
            <li class="group h-full">
                <a href="create_listing.html" class="block h-full p-8 rounded-2xl border theme-bg-card theme-border theme-card-hover transition-all duration-300 flex flex-col items-center text-center shadow-sm hover:shadow-md transform hover:-translate-y-1">
                    <div class="h-14 w-14 rounded-full flex items-center justify-center mb-4 transition-colors bg-green-50 text-green-600 group-hover:bg-green-600 group-hover:text-white">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                    </div>
                    <span class="text-xl font-bold theme-text-main group-hover:text-green-600 transition-colors">Sell an Item</span>
                    <p class="mt-2 text-sm theme-text-muted">List your products and start earning.</p>
                </a>
            </li>

            {# Chat Card (Conditional Check using string conversion like in ListingDetails) #}
            {% set raw_model = gui_model | string %}
            {% if "Class(ChatScreen" in raw_model or "Class(ChatComponent" in raw_model %}
            <li class="group h-full">
                <a href="chat.html" class="block h-full p-8 rounded-2xl border theme-bg-card theme-border theme-card-hover transition-all duration-300 flex flex-col items-center text-center shadow-sm hover:shadow-md transform hover:-translate-y-1">
                    <div class="h-14 w-14 rounded-full flex items-center justify-center mb-4 transition-colors bg-purple-50 text-purple-600 group-hover:bg-purple-600 group-hover:text-white">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                        </svg>
                    </div>
                    <span class="text-xl font-bold theme-text-main group-hover:text-purple-600 transition-colors">Messages</span>
                    <p class="mt-2 text-sm theme-text-muted">Chat with buyers and sellers.</p>
                </a>
            </li>
            {% endif %}
        </ul>
    </nav>

    {# --- Action Bar --- #}
    <div class="mt-12 py-6 border-t theme-border">
        <div class="max-w-6xl mx-auto flex justify-between items-center px-2">
            <button id="PROFILEBUTTON" 
                    onclick="location.href='profile.html'"
                    class="flex items-center gap-2 font-medium theme-text-main hover:opacity-75 transition-opacity">
                <div class="p-2 bg-gray-200 rounded-full text-gray-600">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                </div>
                <span>My Profile</span>
            </button>

            <button id="LOGOUTBUTTON" 
                    class="flex items-center gap-2 text-red-500 font-bold hover:text-red-600 hover:bg-red-50 px-4 py-2 rounded-lg transition-colors border border-transparent hover:border-red-100">
                <span>Logout</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
            </button>
        </div>
    </div>
</div>
{% endblock %}