{% extends "base.html.jinja2" %}

{% block content %}
{% if dsml.blocks.blocks[0].inputs.FEATURES.block.fields.enableChat == 'True' %}
    <div id="ChatScreen">
        <h2>Messages</h2>
        
        <div id="MESSAGELIST" style="height: 300px; overflow-y: scroll; border: 1px solid #eee;">
            </div>

        <div class="chat-input-area">
            <input type="text" id="INPUTFIELD" placeholder="Type a message..." />
            <button id="SENDBUTTON">Send</button>
        </div>
    </div>
{% else %}
    <div id="ChatScreen">
        <h3>Chat is disabled for this community.</h3>
        <button onclick="history.back()">Go Back</button>
    </div>
{% endif %}
{% endblock %}