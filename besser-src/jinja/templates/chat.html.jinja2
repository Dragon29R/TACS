{% extends "base.html.jinja2" %}

{% block title %}Chat - {{ dsml.text.appName }}{% endblock %}

{% block content %}
<div class="flex w-full h-[80vh] bg-white rounded-lg border border-gray-200 overflow-hidden" id="chat-app">
    
    <div class="w-1/3 min-w-[250px] border-r border-gray-200 bg-gray-50 flex flex-col">
        
        <div class="p-4 border-b border-gray-200 bg-white flex justify-between items-center">
            <h2 class="font-bold text-gray-700">Conversations</h2>
            <span id="total-count" class="bg-blue-100 text-blue-800 text-xs font-semibold px-2.5 py-0.5 rounded-full">0</span>
        </div>
        
        {# Conversations List Container #}
        <div id="conversations-list" class="overflow-y-auto flex-1">
            </div>
    </div>

    <div class="flex-1 flex flex-col min-w-0 bg-white relative">
        
        <div class="h-16 border-b border-gray-200 px-6 flex justify-between items-center bg-white shadow-sm z-10">
            <div class="flex items-center gap-3" id="chat-header-info">
                </div>
        </div>

        {# Message List #}
        <div id="message-list" class="flex-1 overflow-y-auto p-6 space-y-6 bg-slate-50">
             </div>

        {# Input Area #}
        <div class="bg-white p-4 border-t border-gray-100">
            <form id="message-form" class="relative flex items-center gap-3">
                <div class="flex-grow">
                    <input type="text" 
                           id="message-input" 
                           placeholder="Type a message..." 
                           class="w-full px-5 py-3 bg-gray-50 border border-gray-200 rounded-full focus:outline-none focus:bg-white focus:ring-2 focus:ring-opacity-50 transition-all"
                           style="--tw-ring-color: {{ dsml.theme.primaryColor }};">
                </div>

                <button type="submit" 
                        class="p-3 rounded-full text-white shadow-md hover:shadow-lg hover:opacity-90 transition transform hover:scale-105 flex items-center justify-center"
                        style="background-color: {{ dsml.theme.primaryColor }};">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transform rotate-90 translate-x-[1px]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                    </svg>
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    // State Management ---
    const rawData = {{ data | tojson }};
    
    const state = {
        conversations: rawData.conversations || [],
        currentUserId: rawData.current_user_id || 'u1',
        currentUserAvatar: rawData.current_user_avatar || null,
        activeConvId: null
    };

    if (state.conversations.length > 0) {
        // Find active or default to first
        const active = state.conversations.find(c => c.active);
        state.activeConvId = active ? active.id : state.conversations[0].id;
    }

    function renderConversations() {
        const listContainer = document.getElementById('conversations-list');
        const countBadge = document.getElementById('total-count');
        
        countBadge.textContent = state.conversations.length;
        listContainer.innerHTML = '';

        state.conversations.forEach(conv => {
            const isActive = (conv.id === state.activeConvId);
            
            // Partner Avatar
            let avatarHtml = '';
            if (conv.partner_avatar) {
                avatarHtml = `<img src="${conv.partner_avatar}" class="h-full w-full object-cover">`;
            } else {
                avatarHtml = `<div class="flex items-center justify-center h-full text-lg font-bold text-gray-500 uppercase">${conv.partner_name.charAt(0)}</div>`;
            }

            const item = document.createElement('div');
            item.className = `group relative flex items-center gap-3 p-4 cursor-pointer hover:bg-white hover:shadow-sm transition border-b border-gray-100 ${isActive ? 'bg-white border-l-4 border-l-blue-500 shadow-sm' : 'border-l-4 border-l-transparent'}`;
            item.onclick = () => switchConversation(conv.id);
            
            item.innerHTML = `
                <div class="relative h-12 w-12 rounded-full bg-gray-200 flex-shrink-0 overflow-hidden">
                    ${avatarHtml}
                    ${conv.is_online ? '<span class="absolute bottom-0 right-0 block h-3 w-3 rounded-full ring-2 ring-white bg-green-400"></span>' : ''}
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex justify-between items-baseline mb-1">
                        <h3 class="text-sm font-semibold text-gray-900 truncate ${isActive ? 'text-blue-600' : ''}">
                            ${conv.partner_name}
                        </h3>
                        <span class="text-xs text-gray-400 flex-shrink-0 ml-2">${conv.last_timestamp}</span>
                    </div>
                    <p class="text-xs text-gray-500 truncate group-hover:text-gray-700 transition-colors">
                        ${conv.last_message}
                    </p>
                </div>
            `;
            listContainer.appendChild(item);
        });
    }

    function renderActiveChat() {
        const headerInfo = document.getElementById('chat-header-info');
        const messageList = document.getElementById('message-list');
        const activeConv = state.conversations.find(c => c.id === state.activeConvId);

        if (!activeConv) return;

        // Header Avatar
        let headerAvatar = '';
        if (activeConv.partner_avatar) {
            headerAvatar = `<img src="${activeConv.partner_avatar}" class="h-full w-full object-cover">`;
        } else {
            headerAvatar = `<div class="flex items-center justify-center h-full font-bold text-gray-500">${activeConv.partner_name.charAt(0)}</div>`;
        }

        headerInfo.innerHTML = `
            <div class="h-10 w-10 rounded-full bg-gray-200 overflow-hidden">
                ${headerAvatar}
            </div>
            <div>
                <h2 class="text-base font-bold text-gray-800 leading-tight">
                    ${activeConv.partner_name}
                </h2>
                <div class="flex items-center gap-1.5">
                    <div class="h-2 w-2 rounded-full ${activeConv.is_online ? 'bg-green-500' : 'bg-gray-400'}"></div>
                    <span class="text-xs text-gray-500">${activeConv.is_online ? 'Online' : 'Offline'}</span>
                </div>
            </div>
        `;

        // Render Messages
        messageList.innerHTML = '';
        const messages = activeConv.messages || [];

        if (messages.length === 0) {
            messageList.innerHTML = `
                <div class="h-full flex flex-col items-center justify-center text-gray-400 gap-2">
                    <p>No messages yet. Say hello!</p>
                </div>`;
        } else {
            messages.forEach(msg => {
                const isMe = (msg.sender_id === state.currentUserId);
                
                // Determine Avatar Source
                // Priority: Message Avatar -> User State Avatar (if Me) -> Placeholder
                let avatarSrc = msg.sender_avatar;
                if (!avatarSrc && isMe) {
                    avatarSrc = state.currentUserAvatar;
                }

                let msgAvatarHtml = '';
                if (avatarSrc) {
                    msgAvatarHtml = `<img src="${avatarSrc}" class="h-full w-full object-cover">`;
                } else {
                    msgAvatarHtml = `<div class="flex items-center justify-center h-full text-xs text-gray-600 font-bold">?</div>`;
                }
                
                // Runtime Primary Color
                const primaryColor = '{{ dsml.theme.primaryColor }}' || '#3b82f6';

                const msgHtml = `
                    <div class="flex w-full ${isMe ? 'justify-end' : 'justify-start'}">
                        <div class="flex max-w-[75%] ${isMe ? 'flex-row-reverse' : 'flex-row'} gap-3">
                            <div class="flex-shrink-0 h-9 w-9 rounded-full bg-gray-300 overflow-hidden self-end mb-1 shadow-sm">
                                ${msgAvatarHtml}
                            </div>
                            <div class="flex flex-col ${isMe ? 'items-end' : 'items-start'}">
                                <div class="px-5 py-3 rounded-2xl shadow-sm text-sm leading-relaxed ${isMe ? 'text-white rounded-br-sm' : 'bg-white text-gray-800 border border-gray-100 rounded-bl-sm'}"
                                     style="${isMe ? `background-color: ${primaryColor}` : ''}">
                                    ${msg.content}
                                </div>
                                <span class="text-[10px] text-gray-400 mt-1 px-1">
                                    ${msg.timestamp}
                                </span>
                            </div>
                        </div>
                    </div>
                `;
                messageList.insertAdjacentHTML('beforeend', msgHtml);
            });
        }
        
        messageList.scrollTop = messageList.scrollHeight;
    }

    function switchConversation(id) {
        state.activeConvId = id;
        renderConversations();
        renderActiveChat();
    }

    function sendMessage(e) {
        e.preventDefault();
        const input = document.getElementById('message-input');
        const text = input.value.trim();
        
        if (!text || !state.activeConvId) return;

        const activeConv = state.conversations.find(c => c.id === state.activeConvId);
        
        // Add new message
        const newMsg = {
            id: 'm_' + Date.now(),
            sender_id: state.currentUserId,
            sender_avatar: state.currentUserAvatar, 
            content: text,
            timestamp: 'Just now'
        };

        if (!activeConv.messages) activeConv.messages = [];
        activeConv.messages.push(newMsg);

        // Update conversation metadata
        activeConv.last_message = text;
        activeConv.last_timestamp = 'Just now';

        input.value = '';
        renderConversations();
        renderActiveChat();
    }

    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('message-form');
        if (form) form.addEventListener('submit', sendMessage);

        renderConversations();
        renderActiveChat();
    });

</script>
{% endblock %}