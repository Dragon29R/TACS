{% extends "base.html.jinja2" %}

{% block title %}Chat - {{ dsml.text.appName }}{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto bg-white shadow-lg rounded-lg overflow-hidden h-[80vh] flex flex-col">
    
    {# Chat Header #}
    <div class="bg-gray-50 border-b p-4 flex justify-between items-center">
        <h2 class="text-lg font-semibold text-gray-800">
            {{ data.title if data.title else 'Chat' }}
        </h2>
        {% if data.partner %}
        <div class="flex items-center gap-2">
            <span class="text-sm text-gray-500">{{ data.partner.name }}</span>
            <div class="h-3 w-3 rounded-full {{ 'bg-green-500' if data.partner.is_online else 'bg-gray-400' }}"></div>
        </div>
        {% endif %}
    </div>

    {# Message List #}
    <div id="MessageListComponent" class="flex-1 overflow-y-auto p-4 space-y-4 bg-gray-50">
        {% if data.messages %}
            {% for msg in data.messages %}
                {% set is_me = (msg.sender_id == data.current_user_id) %}
                
                <div class="flex w-full {{ 'justify-end' if is_me else 'justify-start' }}">
                    <div class="flex max-w-[70%] {{ 'flex-row-reverse' if is_me else 'flex-row' }} gap-2">
                        
                        {# Avatar #}
                        <div class="flex-shrink-0 h-8 w-8 rounded-full bg-gray-300 overflow-hidden">
                            {% if msg.sender_avatar %}
                                <img src="{{ msg.sender_avatar }}" alt="Avatar" class="h-full w-full object-cover">
                            {% else %}
                                <div class="flex items-center justify-center h-full text-xs text-gray-600">?</div>
                            {% endif %}
                        </div>

                        {# Message Bubble #}
                        <div class="p-3 rounded-lg shadow-sm {{ 'bg-blue-500 text-white rounded-tr-none' if is_me else 'bg-white text-gray-800 rounded-tl-none' }}"
                             style="{{ ('background-color: ' + dsml.theme.primaryColor) if is_me else '' }}">
                            <p class="text-sm">{{ msg.content }}</p>
                            <span class="text-[10px] block mt-1 opacity-70 {{ 'text-right' if is_me else 'text-left' }}">
                                {{ msg.timestamp }}
                            </span>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <div class="h-full flex items-center justify-center text-gray-400">
                <p>No messages yet. Start the conversation!</p>
            </div>
        {% endif %}
    </div>

    {# Input Area #}
    <div class="bg-white border-t p-4">
        <form class="flex items-center gap-2" onsubmit="event.preventDefault();">
            
            <div class="flex-grow">
                <input type="text" 
                       id="NewMessageField" 
                       placeholder="Type your message..." 
                       class="w-full px-4 py-2 border rounded-full focus:outline-none focus:ring-2 focus:ring-opacity-50"
                       style="--tw-ring-color: {{ dsml.theme.primaryColor }};">
            </div>

            <button type="submit" 
                    id="SendButton"
                    class="p-2 rounded-full text-white hover:opacity-90 transition shadow-md"
                    style="background-color: {{ dsml.theme.primaryColor }};">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transform rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
            </button>
        </form>
    </div>
</div>

<script>
    const messageList = document.getElementById('MessageListComponent');
    if (messageList) {
        messageList.scrollTop = messageList.scrollHeight;
    }
</script>
{% endblock %}