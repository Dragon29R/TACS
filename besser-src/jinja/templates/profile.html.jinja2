{% extends "base.html" %}

{% block content %}
<div id="ProfileScreen">
    <h2>My Profile</h2>
    
    <div class="user-info">
        {% set fields = dsml.blocks.blocks[0].inputs.USER_FIELDS_LIST.block.fields %}
        
        {% if fields.full_name == 'True' %}
            <p><strong>Name:</strong> <span id="val-fullname">John Doe</span></p>
        {% endif %}
        
        {% if fields.nickname == 'True' %}
            <p><strong>Nickname:</strong> <span id="val-nick">J-Dog</span></p>
        {% endif %}

        {% if fields.address == 'True' %}
            <p><strong>Address:</strong> <span id="val-address">123 Main St</span></p>
        {% endif %}

        {% if fields.age == 'True' %}
            <p><strong>Age:</strong> <span id="val-age">30</span></p>
        {% endif %}
    </div>

    {% if gui_model.get_class_by_name('EditProfileButton') %}
    <button id="EditProfileButton">Edit Profile</button>
    {% endif %}

</div>
{% endblock %}